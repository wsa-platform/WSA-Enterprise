# WSA-Enterprise production environment template
# Copy to the production host as .env; never commit the real file.
# Replace every placeholder before first production deployment.

COMPOSE_PROJECT_NAME=wsa-enterprise

# Public application
DOMAIN=app.example.com
CERTBOT_EMAIL=ops@example.com
VITE_API_URL=https://app.example.com/api/v1
FRONTEND_URL=https://app.example.com
# Optional extra browser origins. Production CORS never auto-includes localhost and must not use *.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
VITE_SHOW_DEMO_LOGIN=false

# GHCR deployment
IMAGE_TAG=main
GHCR_IMAGE_PREFIX=ghcr.io/wsa-platform

# PostgreSQL — generate a strong unique value and store it only on the production host.
POSTGRES_DB=wsa_enterprise
POSTGRES_USER=wsa
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_SECRET

# Add other Laravel/backend production secrets here when required by the application.
# Never place real passwords, API keys, tokens, SSH private keys, or certificates in Git.
#
# Backend production flags (names only — set values in backend/.env on the host, never here):
# APP_ENV
# APP_DEBUG
# APP_KEY
# APP_URL
# LOG_CHANNEL
# LOG_LEVEL
# QUEUE_CONNECTION
# SCIENTIFIC_HTTP_TIMEOUT
# FRONTEND_URL
# CORS_ALLOWED_ORIGINS
# DATABASE_URL
# DB_CONNECTION
# DB_SSLMODE
# REDIS_HOST
# REDIS_URL
# CACHE_STORE
# SESSION_DRIVER
# OPENALEX_MAILTO
# WSA_RESEARCH_AGENT_ENABLED
# WSA_PLANT_DIAGNOSIS_ENABLED

