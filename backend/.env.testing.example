APP_NAME="WSA Enterprise Testing"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

# Isolated PostgreSQL test database — never use wsa_enterprise (staging).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wsa_enterprise_test
DB_USERNAME=wsa
DB_PASSWORD=secret

# Comma-separated databases PHPUnit must refuse to touch.
FORBIDDEN_TEST_DATABASES=wsa_enterprise

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=null
MAIL_MAILER=array

AI_PROVIDER=mock
AI_TIMEOUT=30
AI_ASYNC_DISPATCH=false

ALLOW_REGISTRATION=false
