APP_NAME="WSA Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8081
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wsa_enterprise
DB_USERNAME=wsa
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# PHPUnit must never target the staging database name.
FORBIDDEN_TEST_DATABASES=wsa_enterprise

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=mock
AI_TIMEOUT=30
AI_QUEUE=default
AI_QUEUE_TRIES=3
AI_ASYNC_DISPATCH=false

# Production hardening (Phase 8)
ALLOW_REGISTRATION=false
# Public Job-Seeker signup is independent of service-owner registration.
ALLOW_JOB_SEEKER_REGISTRATION=true
ALLOW_EMPLOYER_REGISTRATION=true
SANCTUM_TOKEN_EXPIRATION=
# Set SANCTUM_TOKEN_EXPIRATION=43200 for 30-day mobile tokens (minutes)

# --- Production overrides (copy to .env on deploy) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# FRONTEND_URL=https://app.example.com
# SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com
#
# Render PostgreSQL (set in Render dashboard; never commit secrets):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_CONNECTION=pgsql
# DB_SSLMODE=require
# Do not set PGSSLCERT, PGSSLKEY, or PGSSLROOTCERT on Render unless using mutual TLS.
# Without Redis on Render, omit CACHE_STORE/SESSION_DRIVER to use file drivers.
# Optional explicit overrides:
# CACHE_STORE=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=database
#
# Production admin bootstrap (set in Render dashboard; never commit secrets):
# ADMIN_EMAIL=admin@wsa.test
# ADMIN_PASSWORD=choose-a-strong-password-min-12-chars
# ADMIN_NAME="Platform Administrator"
# ADMIN_ORGANIZATION_NAME="WSA Enterprise"
# ADMIN_ORGANIZATION_SLUG=wsa-enterprise
#
# Extra CORS origins (comma-separated). Production uses only this list plus FRONTEND_URL — localhost is not auto-included when APP_ENV=production.
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
#
# Google OAuth (Phase 3 / M20 auth):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
