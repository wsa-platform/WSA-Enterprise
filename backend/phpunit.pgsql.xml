<?xml version="1.0" encoding="UTF-8"?>
<!--
    Opt-in, destructive PostgreSQL suite (IC Persistence integrity). Requires DB_TEST_HOST (loopback),
    DB_TEST_PORT, DB_TEST_DATABASE (*_test), DB_TEST_USERNAME, DB_TEST_PASSWORD, and
    DB_TEST_ALLOW_DESTRUCTIVE_RESET set to the same database name, on a dedicated disposable server;
    see tests/bootstrap-pgsql.php. The default phpunit.xml suite stays on sqlite :memory:.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-pgsql.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL">
            <directory>tests/Unit/Agriculture/Research/IntegrationClassification</directory>
            <directory>tests/Pgsql</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="AI_ASYNC_DISPATCH" value="false"/>
        <env name="AI_QUOTA_ENABLED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
